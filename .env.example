# Slack tokens (api.slack.com/apps → tu app)
# Asegurate de habilitar Socket Mode y crear un App-Level Token con scope `connections:write`.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# SQLite database path
DB_PATH=./data/reminders.db

# Zona horaria por defecto del creador (se usa si users.info no la devuelve)
DEFAULT_TIMEZONE=America/Bogota

# Frecuencia del tick scheduler en segundos (default: 30). Bajalo a 10 si querés
# precisión sub-minuto; subilo a 60 para reducir CPU.
SCHEDULER_TICK_SECONDS=30

# Set 'true' para deshabilitar el scheduler completo (útil para testing local
# sin spamear el workspace).
CRON_DISABLED=false

# Log level: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info
